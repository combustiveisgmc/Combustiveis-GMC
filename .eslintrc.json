{
  "root": true,
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "env": { "es2022": true },
  "rules": {
    "no-undef": "error",
    "no-dupe-keys": "error",
    "no-dupe-args": "error",
    "no-duplicate-case": "error",
    "no-unreachable": "error",
    "no-func-assign": "error",
    "no-import-assign": "error",
    "no-const-assign": "error",
    "no-self-assign": "error",
    "valid-typeof": "error",
    "use-isnan": "error",
    "no-unsafe-negation": "error",
    "no-debugger": "error",
    "no-redeclare": "error",
    "no-unused-vars": ["warn", { "args": "none", "caughtErrors": "none", "varsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["public/**/*.js"],
      "env": { "browser": true },
      "globals": { "confirmar": "readonly", "L": "readonly" }
    },
    {
      "files": ["public/sw.js"],
      "env": { "browser": true, "serviceworker": true }
    },
    {
      "files": ["functions/**/*.js", "lib/**/*.js"],
      "env": { "worker": true },
      "globals": { "crypto": "readonly", "fetch": "readonly", "Response": "readonly", "Request": "readonly", "URL": "readonly", "console": "readonly", "AbortSignal": "readonly" }
    },
    {
      "files": ["scripts/**/*.mjs", "scripts/**/*.js", "tests/**/*.mjs"],
      "env": { "node": true }
    }
  ],
  "ignorePatterns": ["node_modules/", ".wrangler/", ".dados/", "original/", "prototipos/", "site/", "CONTROLES/", "public/gestao/mapas/*.json"]
}
